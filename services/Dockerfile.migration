# ── Build stage ───────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /build
# Install production dependencies
COPY services/package.json services/package-lock.json ./
RUN npm ci --omit=dev

# ── Runtime stage ─────────────────────────────────────────────
FROM node:22-alpine
WORKDIR /app
COPY --from=builder /build/node_modules ./node_modules
COPY services/package.json ./
COPY services/migration-service/migration-service.js ./migration-service.js
EXPOSE 3099
CMD ["node", "migration-service.js"]
