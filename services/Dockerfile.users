# ── Build stage ───────────────────────────────────────────────
FROM rust:1 AS builder
WORKDIR /build
COPY services/Cargo.toml services/Cargo.lock services/rust-toolchain.toml ./
COPY services/common ./common
# Stub workspace members not being built
COPY services/location-service/Cargo.toml ./location-service/Cargo.toml
RUN mkdir -p ./location-service/src && echo 'fn main(){}' > ./location-service/src/main.rs
COPY services/blocks-service/Cargo.toml ./blocks-service/Cargo.toml
RUN mkdir -p ./blocks-service/src && echo 'fn main(){}' > ./blocks-service/src/main.rs
COPY services/favourites-service/Cargo.toml ./favourites-service/Cargo.toml
RUN mkdir -p ./favourites-service/src && echo 'fn main(){}' > ./favourites-service/src/main.rs
COPY services/messages-service/Cargo.toml ./messages-service/Cargo.toml
RUN mkdir -p ./messages-service/src && echo 'fn main(){}' > ./messages-service/src/main.rs
# Build target
COPY services/users-service ./users-service
COPY services/gateway/Cargo.toml ./gateway/Cargo.toml
RUN mkdir -p ./gateway/src && echo 'fn main(){}' > ./gateway/src/main.rs
COPY services/migration-service/Cargo.toml ./migration-service/Cargo.toml
RUN mkdir -p ./migration-service/src && echo 'fn main(){}' > ./migration-service/src/main.rs
COPY services/authority-service/Cargo.toml ./authority-service/Cargo.toml
RUN mkdir -p ./authority-service/src && echo 'fn main(){}' > ./authority-service/src/main.rs
COPY services/server/Cargo.toml ./server/Cargo.toml
RUN mkdir -p ./server/src && echo 'fn main(){}' > ./server/src/main.rs
RUN cargo build --release --locked -p users-service

# ── Runtime stage ─────────────────────────────────────────────
FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates libssl3 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/users-service /usr/local/bin/users-service
EXPOSE 8080
CMD ["/usr/local/bin/users-service"]
